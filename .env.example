# 本地开发可全部留空，继续使用 data/resume.sqlite。
# Vercel 必须配置下面两个值（服务端环境变量，不使用 NEXT_PUBLIC_ 前缀）。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 管理页面的实际来源，如 https://www.lqp7.info，不带末尾斜杠。
APP_ORIGIN=

# 空云数据库首次初始化时可创建管理员；已迁移管理员则不需要。
# 只在不存在管理员时生效，不能用来重置已有密码。
RESUME_ADMIN_USERNAME=admin
RESUME_ADMIN_PASSWORD=

# 只用于本地 SQLite / 迁移源路径，Vercel 上无需设置。
RESUME_DB_PATH=
